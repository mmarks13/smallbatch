from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent
FUNCTION = json.loads((ROOT / "function.json").read_text())


def validate_input(item):
    if not isinstance(item, dict):
        raise ValueError("input must be a JSON object")
    schema = FUNCTION["input_schema"]
    missing = [name for name in schema if name not in item]
    extra = [name for name in item if name not in schema]
    if missing or extra:
        raise ValueError(f"input mismatch: missing={missing}, extra={extra}")
    for name, kind in schema.items():
        value = item[name]
        valid = {
            "string": isinstance(value, str),
            "integer": isinstance(value, int) and not isinstance(value, bool),
            "number": isinstance(value, (int, float)) and not isinstance(value, bool),
            "boolean": isinstance(value, bool),
        }[kind]
        if not valid:
            raise ValueError(f"input field {name!r} must be {kind}")
    return {name: item[name] for name in schema}


def validate_output(value):
    fields = FUNCTION["output"]["fields"]
    scalar = list(fields) == ["score"]
    values = {"score": value} if scalar else value
    if not isinstance(values, dict) or set(values) != set(fields):
        raise ValueError("model output failed the function contract")
    for name, field in fields.items():
        current = values[name]
        if field.get("range") is not None:
            lo, hi = field["range"]
            if not isinstance(current, int) or isinstance(current, bool) or not lo <= current <= hi:
                raise ValueError(f"invalid integer output for {name}")
        elif current not in field["labels"]:
            raise ValueError(f"invalid enum output for {name}")
    return values["score"] if scalar else values


def render_input(item):
    return "\n".join(
        f"{name}: {json.dumps(item[name], ensure_ascii=False)}"
        for name in FUNCTION["input_schema"]
    )


def ordinal_predict(head, features):
    """Class values from an ordered head: each step scores P(y > level), the
    chain is forced monotonic, and differencing gives the class distribution.
    The head's dev-selected decode rule reads a level out of each row; heads
    persisted without one decode as argmax, as they were evaluated."""
    import numpy as np

    values = head["values"]
    rows = features.shape[0]
    above = np.empty((rows, len(head["steps"])), dtype=float)
    for index, step in enumerate(head["steps"]):
        if step["model"] is None:
            above[:, index] = step["above"]
            continue
        probabilities = step["model"].predict_proba(features)
        classes = list(step["model"].classes_)
        above[:, index] = probabilities[:, classes.index(1)]
    above = np.minimum.accumulate(above, axis=1)
    padded = np.concatenate([np.ones((rows, 1)), above, np.zeros((rows, 1))], axis=1)
    probabilities = padded[:, :-1] - padded[:, 1:]
    decoder = head.get("decoder", "argmax")
    if decoder == "median":
        chosen = (probabilities.cumsum(axis=1) >= 0.5).argmax(axis=1)
    elif decoder == "within_one":
        window = probabilities.copy()
        window[:, :-1] += probabilities[:, 1:]
        window[:, 1:] += probabilities[:, :-1]
        chosen = window.argmax(axis=1)
    else:
        chosen = probabilities.argmax(axis=1)
    return [values[int(index)] for index in chosen]


def metadata():
    evidence = ROOT / "evidence.json"
    return {
        "function": FUNCTION,
        "evidence": json.loads(evidence.read_text()) if evidence.exists() else None,
    }
