from __future__ import annotations

import json
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent
FUNCTION = json.loads((ROOT / "function.json").read_text())

# C0 controls other than newline and tab, plus NUL and DEL: never valid in a
# generated text value
_UNSAFE_TEXT_CHARS = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")


class InvalidOutputError(ValueError):
    """The model's output violated this function's declared contract.

    The output is atomic: when this is raised there is no partial result, no
    repaired result, and no retry — the caller decides what to do. `category`
    names the structural failure: `malformed_json`, `contract`, `empty_text`,
    `char_limit`, or `budget_exhausted`.
    """

    def __init__(self, message, category="contract"):
        super().__init__(message)
        self.category = category


def validate_input(item):
    if not isinstance(item, dict):
        raise ValueError("input must be a JSON object")
    schema = FUNCTION["input_schema"]
    missing = [name for name in schema if name not in item]
    extra = [name for name in item if name not in schema]
    if missing or extra:
        raise ValueError(f"input mismatch: missing={missing}, extra={extra}")
    for name, kind in schema.items():
        value = item[name]
        valid = {
            "string": isinstance(value, str),
            "integer": isinstance(value, int) and not isinstance(value, bool),
            "number": isinstance(value, (int, float)) and not isinstance(value, bool),
            "boolean": isinstance(value, bool),
        }[kind]
        if not valid:
            raise ValueError(f"input field {name!r} must be {kind}")
    return {name: item[name] for name in schema}


def _validate_text(name, field, value):
    if not isinstance(value, str):
        raise InvalidOutputError(f"output field {name!r} must be a string")
    stripped = value.strip()
    if not stripped:
        raise InvalidOutputError(
            f"output field {name!r} is empty", category="empty_text"
        )
    if _UNSAFE_TEXT_CHARS.search(stripped):
        raise InvalidOutputError(
            f"output field {name!r} contains an unsafe control character"
        )
    if len(stripped) > field["max_chars"]:
        raise InvalidOutputError(
            f"output field {name!r} is {len(stripped)} characters; the contract "
            f"allows at most {field['max_chars']} (never truncated)",
            category="char_limit",
        )
    return stripped


def validate_output(value):
    """Validate one complete output; returns the declared shape or raises
    InvalidOutputError. Atomic: a single invalid field fails the whole value."""
    fields = FUNCTION["output"]["fields"]
    scalar = list(fields) == ["score"]
    values = {"score": value} if scalar else value
    if not isinstance(values, dict) or set(values) != set(fields):
        raise InvalidOutputError("model output failed the function contract")
    checked = {}
    for name, field in fields.items():
        current = values[name]
        if field.get("max_chars") is not None:
            checked[name] = _validate_text(name, field, current)
        elif field.get("range") is not None:
            lo, hi = field["range"]
            if not isinstance(current, int) or isinstance(current, bool) or not lo <= current <= hi:
                raise InvalidOutputError(f"invalid integer output for {name}")
            checked[name] = current
        elif current not in field["labels"]:
            raise InvalidOutputError(f"invalid enum output for {name}")
        else:
            checked[name] = current
    return checked["score"] if scalar else checked


def parse_strict_json(text, exhausted=False):
    """Parse one generated completion as exactly the declared JSON value.

    Tolerates only outer whitespace; rejects code fences, preambles, trailing
    content, duplicate keys, and keys out of declared order (field order is
    generation order, so a reordered object is a different function). Returns
    the validated output or raises InvalidOutputError.
    """

    def no_duplicates(pairs):
        keys = [key for key, _ in pairs]
        if len(keys) != len(set(keys)):
            raise ValueError("duplicate keys")
        return dict(pairs)

    stripped = text.strip()
    try:
        if not stripped:
            raise ValueError("empty completion")
        value, end = json.JSONDecoder(object_pairs_hook=no_duplicates).raw_decode(stripped)
        if stripped[end:].strip():
            raise ValueError("trailing content")
    except ValueError:
        raise InvalidOutputError(
            "completion is not exactly one JSON value",
            category="budget_exhausted" if exhausted else "malformed_json",
        ) from None
    fields = FUNCTION["output"]["fields"]
    if list(fields) != ["score"]:
        if not isinstance(value, dict) or list(value) != list(fields):
            raise InvalidOutputError("JSON keys do not match the declared field order")
    return validate_output(value)


def render_input(item):
    return "\n".join(
        f"{name}: {json.dumps(item[name], ensure_ascii=False)}"
        for name in FUNCTION["input_schema"]
    )


def ordinal_predict(head, features):
    """Argmax class values from the softmax ordinal head: scale, one or two
    affine layers, softmax over the levels — plain numpy arrays are the whole
    runtime, no torch and no Smallbatch."""
    import numpy as np

    values = head["values"]
    scaler = head.get("scaler")
    x = features
    if scaler is not None:
        x = (np.asarray(x, dtype="float64") - scaler["mean"]) / scaler["scale"]
    layers = head["layers"]
    out = x @ layers[0]["weight"].T + layers[0]["bias"]
    out = np.asarray(out, dtype="float64")
    if len(layers) > 1:
        out = np.maximum(out, 0.0)
        out = out @ layers[1]["weight"].T + layers[1]["bias"]
    return [values[int(index)] for index in out.argmax(axis=1)]


def metadata():
    evidence = ROOT / "evidence.json"
    return {
        "function": FUNCTION,
        "evidence": json.loads(evidence.read_text()) if evidence.exists() else None,
    }
