import itertools
import json
import re
from pathlib import Path

from ._common import (
    FUNCTION,
    ROOT,
    InvalidOutputError,
    metadata,
    parse_strict_json,
    render_input,
    validate_input,
    validate_output,
)

__all__ = ["run", "run_batch", "metadata", "InvalidOutputError"]

_MODEL = None
_TOKENIZER = None
_CONSTRAINT_TABLES = None
_INT_RE = re.compile(r"-?\d+")
_SCORE_RE = re.compile(r"score:\s*(-?\d+)", re.I)
_SCORE_VALUE_RE = re.compile(r"^\s*score\s*:\s*(.+)$", re.I | re.M)


def _has_text():
    return any(
        field.get("max_chars") is not None
        for field in FUNCTION["output"]["fields"].values()
    )


def _load_tokenizer(base):
    from transformers import AutoTokenizer, PreTrainedTokenizerFast

    try:
        return AutoTokenizer.from_pretrained(base)
    except ValueError as exc:
        if "Tokenizer class TokenizersBackend does not exist" not in str(exc):
            raise
        from transformers.utils import cached_file

        config_path = cached_file(base, "tokenizer_config.json")
        tokenizer_config = json.loads(Path(config_path).read_text())
        extra_tokens = tokenizer_config.get("extra_special_tokens")
        if isinstance(extra_tokens, list) and extra_tokens:
            raise ValueError(
                "tokenizer requires non-empty Transformers 5 extra_special_tokens; "
                "this package cannot translate them safely to its Transformers 4 runtime"
            ) from exc
        compatibility = {"extra_special_tokens": {}} if isinstance(extra_tokens, list) else {}
        return PreTrainedTokenizerFast.from_pretrained(base, **compatibility)


def _load():
    global _MODEL, _TOKENIZER
    if _MODEL is not None:
        return _TOKENIZER, _MODEL
    import torch
    from peft import PeftModel
    from transformers import AutoModelForCausalLM

    runtime = FUNCTION["runtime"]
    _TOKENIZER = _load_tokenizer(runtime["base_model"])
    if _TOKENIZER.pad_token is None:
        _TOKENIZER.pad_token = _TOKENIZER.eos_token
    precision = runtime.get("inference_precision", "fp32")
    kwargs = {"dtype": torch.bfloat16 if precision == "bf16" else torch.float32}
    try:
        base = AutoModelForCausalLM.from_pretrained(runtime["base_model"], **kwargs)
    except ValueError:
        from transformers import AutoModelForImageTextToText

        base = AutoModelForImageTextToText.from_pretrained(runtime["base_model"], **kwargs)
    _MODEL = PeftModel.from_pretrained(base, ROOT / "model")
    _MODEL.eval()
    return _TOKENIZER, _MODEL


def _parse_field(field, text):
    if field.get("range") is not None:
        match = _INT_RE.search(text)
        if not match:
            return None
        value = int(match.group())
        return value if field["range"][0] <= value <= field["range"][1] else None
    lowered = text.casefold()
    hits = [
        (lowered.find(label.casefold()), -len(label), label)
        for label in sorted(field["labels"], key=len, reverse=True)
        if label.casefold() in lowered
    ]
    return min(hits)[2] if hits else None


def _parse_bounded(text):
    fields = FUNCTION["output"]["fields"]
    if list(fields) == ["score"]:
        if fields["score"].get("range") is not None:
            match = _SCORE_RE.search(text)
            if match:
                value = int(match.group(1))
                if fields["score"]["range"][0] <= value <= fields["score"]["range"][1]:
                    return value
        else:
            match = _SCORE_VALUE_RE.search(text)
            if match:
                return _parse_field(fields["score"], match.group(1))
        return _parse_field(fields["score"], text)
    output = {}
    for name, field in fields.items():
        match = re.search(rf"^\s*{re.escape(name)}\s*:\s*(.+)$", text, re.I | re.M)
        output[name] = _parse_field(field, match.group(1)) if match else None
    return output


def _completion_strings():
    if _has_text():
        return None  # generated text has no finite completion set
    fields = FUNCTION["output"]["fields"]
    choices = []
    for field in fields.values():
        if field.get("range") is not None:
            choices.append(list(range(field["range"][0], field["range"][1] + 1)))
        else:
            choices.append(field["labels"])
    total = 1
    for values in choices:
        total *= len(values)
        if total > 5000:
            return None
    if list(fields) == ["score"]:
        return [f" {value}" for value in choices[0]]
    names = list(fields)
    return [
        " " + "\n".join(f"{name}: {value}" for name, value in zip(names, values))
        for values in itertools.product(*choices)
    ]


def _constraint_tables(tokenizer):
    """Token-prefix trie over the legal completions. It depends only on the
    fixed FUNCTION spec, so build it once: retokenizing up to 5000 completion
    strings per call would dominate the packaged hot path."""
    global _CONSTRAINT_TABLES
    if _CONSTRAINT_TABLES is None:
        completions = _completion_strings()
        if not completions:
            _CONSTRAINT_TABLES = ()
            return _CONSTRAINT_TABLES
        trie, terminals = {}, set()
        for completion in completions:
            ids = tuple(tokenizer(completion, add_special_tokens=False)["input_ids"])
            for index in range(len(ids)):
                trie.setdefault(ids[:index], set()).add(ids[index])
            trie.setdefault(ids, set())
            terminals.add(ids)
        eos = tokenizer.eos_token_id if tokenizer.eos_token_id is not None else tokenizer.pad_token_id
        _CONSTRAINT_TABLES = (trie, terminals, eos)
    return _CONSTRAINT_TABLES


def _constraint(tokenizer, prompt_length):
    tables = _constraint_tables(tokenizer)
    if not tables:
        return None
    trie, terminals, eos = tables

    def allowed(batch_id, input_ids):
        generated = tuple(input_ids[prompt_length:].tolist())
        values = set(trie.get(generated, set()))
        if generated in terminals or not values:
            values.add(eos)
        return list(values)

    return allowed


def _scale_levels():
    """The ordered levels of a scalar integer decision, else None."""
    fields = FUNCTION["output"]["fields"]
    if _has_text() or list(fields) != ["score"] or fields["score"].get("range") is None:
        return None
    low, high = fields["score"]["range"]
    return list(range(low, high + 1))


def _deciding_tokens(tokenizer, levels):
    """Where the level completions diverge, and the token each contributes."""
    tokenized = [
        tokenizer(f" {level}", add_special_tokens=False)["input_ids"] for level in levels
    ]
    shortest = min(len(ids) for ids in tokenized)
    prefix = 0
    while prefix < shortest and len({ids[prefix] for ids in tokenized}) == 1:
        prefix += 1
    deciding = [ids[prefix:] for ids in tokenized]
    if any(len(ids) != 1 for ids in deciding):
        return None
    ids = [only[0] for only in deciding]
    return (prefix, ids) if len(set(ids)) == len(ids) else None


def _run_levels(tokenizer, model, prompts, levels):
    """One forward pass: the distribution over the scale sits in the logits at
    the deciding position; argmax is exactly what constrained greedy decoding
    would emit."""
    import torch

    decision = _deciding_tokens(tokenizer, levels)
    if decision is None:
        return None
    prefix, ids = decision
    lead = tokenizer(f" {levels[0]}", add_special_tokens=False)["input_ids"][:prefix]
    tokenizer.padding_side = "left"
    encoded = tokenizer(
        [prompt + tokenizer.decode(lead) if lead else prompt for prompt in prompts],
        return_tensors="pt",
        padding=True,
        truncation=True,
        max_length=2048,
        add_special_tokens=False,
        return_token_type_ids=False,
    )
    with torch.no_grad():
        logits = model(**encoded).logits[:, -1, :].float()
    chosen = logits[:, torch.tensor(ids)].argmax(dim=-1)
    return [levels[int(index)] for index in chosen]


def _generate(tokenizer, model, prompts, constrained):
    """Deterministic greedy generation with the packaged decoding settings.

    Sampling is disabled and no top-p/top-k/temperature behavior exists; EOS
    ends generation normally. Returns (decoded texts, exhausted flags) where
    exhausted marks a row that spent the whole recorded token budget without
    emitting EOS.
    """
    import torch

    decoding = FUNCTION["runtime"]["decoding"]
    max_new = decoding["max_new_tokens"]
    tokenizer.padding_side = "left"
    encoded = tokenizer(
        prompts,
        return_tensors="pt",
        padding=True,
        truncation=True,
        max_length=2048,
        return_token_type_ids=False,
    )
    extra = {}
    if constrained:
        allowed_fn = _constraint(tokenizer, encoded["input_ids"].shape[1])
        if allowed_fn is not None:
            extra["prefix_allowed_tokens_fn"] = allowed_fn
    with torch.no_grad():
        try:
            generated = model.generate(
                **encoded,
                max_new_tokens=max_new,
                do_sample=False,
                pad_token_id=tokenizer.pad_token_id,
                **extra,
            )
        except ValueError as exc:
            if "has_previous_state" not in str(exc):
                raise
            generated = model.generate(
                **encoded,
                max_new_tokens=max_new,
                do_sample=False,
                use_cache=False,
                pad_token_id=tokenizer.pad_token_id,
                **extra,
            )
    new = generated[:, encoded["input_ids"].shape[1]:]
    texts = tokenizer.batch_decode(new, skip_special_tokens=True)
    end_ids = {tokenizer.eos_token_id, tokenizer.pad_token_id} - {None}
    exhausted = [
        len(row) >= max_new and not (end_ids & set(row)) for row in new.tolist()
    ]
    return texts, exhausted


def run_batch(items):
    """Complete validated outputs for every item, in order.

    Raises InvalidOutputError the moment any generated output violates the
    contract: no partial dictionaries, no omitted fields, no silent repair,
    no automatic retry.
    """
    normalized = [validate_input(item) for item in items]
    if not normalized:
        return []
    tokenizer, model = _load()
    prompts = [
        f"[{FUNCTION['name']}]\n{render_input(item)}\noutput:" for item in normalized
    ]
    levels = _scale_levels()
    if levels is not None:
        outputs = _run_levels(tokenizer, model, prompts, levels)
        if outputs is not None:
            return [validate_output(output) for output in outputs]
    if _has_text():
        raw, exhausted = _generate(tokenizer, model, prompts, constrained=False)
        return [
            parse_strict_json(text, exhausted=spent)
            for text, spent in zip(raw, exhausted)
        ]
    raw, _ = _generate(tokenizer, model, prompts, constrained=True)
    return [validate_output(_parse_bounded(text)) for text in raw]


def run(item):
    return run_batch([item])[0]
